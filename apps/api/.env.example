# development locally; Vercel sets production (also the default when unset)
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Comma-separated browser origins allowed to call the API (no trailing slash).
# One "*" may stand for a single label, e.g. for Vercel preview deployments:
# https://today-s-weather-web.vercel.app,https://today-s-weather-*-buivangiaphats-projects.vercel.app
CORS_ORIGINS=http://localhost:5173
# Server-side only, never expose it to the frontend
OPENWEATHER_API_KEY=
# Reverse proxies in front of the API: 0 locally, 1 on Vercel/Railway/Render (real client IP for rate limiting)
TRUST_PROXY=0
# Optional. Local: `pnpm infra:up` then redis://127.0.0.1:6380. Production: Upstash rediss://...
# Empty = cache and rate-limit counters in memory (per instance)
REDIS_URL=
# Postgres (used from P2-01). Local: `pnpm infra:up` → port 5433 (5432 may be taken by WSL).
# Production: Neon via the Vercel integration sets DATABASE_URL (pooled, app queries)
# and DATABASE_URL_UNPOOLED (direct, Prisma migrations).
DATABASE_URL=postgresql://weather:weather@127.0.0.1:5433/weather
DATABASE_URL_UNPOOLED=postgresql://weather:weather@127.0.0.1:5433/weather
# Signs access tokens (min 32 chars). Generate:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Web app origin used in email links and OAuth redirects (default: first CORS origin)
WEB_URL=http://localhost:5173
# Email (verification, password reset). Empty: not sent; development logs them.
# Gmail: smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
# Brevo: smtp://LOGIN:SMTP_KEY@smtp-relay.brevo.com:587
SMTP_URL=
MAIL_FROM=Today's Weather <you@gmail.com>
# Google sign-in (optional). Authorized redirect URI at Google: <API_PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:5173
