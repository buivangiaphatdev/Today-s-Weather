NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Comma-separated browser origins allowed to call the API (no trailing slash)
CORS_ORIGINS=http://localhost:5173
# Server-side only, never expose it to the frontend
OPENWEATHER_API_KEY=
# Reverse proxies in front of the API: 0 locally, 1 on Railway/Render (real client IP for rate limiting)
TRUST_PROXY=0
